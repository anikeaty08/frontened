# Never commit this file after adding real credentials. Copy to .env instead.
MIDNIGHT_NETWORK=preprod
MIDNIGHT_PROOF_SERVER=http://127.0.0.1:6300
# Wallet sync checkpoints are encrypted with AQUA_MIDNIGHT_PRIVATE_STATE_PASSWORD.
# Leave these unset to use the safe defaults: 30-second checkpoints and 120-second inactivity detection.
# MIDNIGHT_WALLET_CHECKPOINT_MS=30000
# The Phase 1 release runner uses 10800000 (three hours) for a first, strict
# Preprod DUST-wallet sync. Override only when deliberately diagnosing a stall.
# MIDNIGHT_SYNC_TIMEOUT_MS=10800000
# Exactly one of these must be supplied for non-local networks.
# MIDNIGHT_WALLET_MNEMONIC=
# MIDNIGHT_WALLET_SEED=

# Exactly 32-byte hexadecimal secrets; keep issuer and attester secrets separate.
# AQUA_MIDNIGHT_ISSUER_AUTH_SECRET_HEX=
# AQUA_MIDNIGHT_ATTESTER_AUTH_SECRET_HEX=
# AQUA_MIDNIGHT_PRIVATE_STATE_PASSWORD=
