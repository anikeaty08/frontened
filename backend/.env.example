NODE_ENV=development
PORT=3000
# The separate Next.js web app origin. Required in production.
AQUA_WEB_ORIGIN=http://localhost:3001
# Leave DATABASE_URL unset only for a local DEVELOPMENT anchor. A Midnight Preprod
# lifecycle requires PostgreSQL/RDS so deployment state and encrypted receipts survive restarts.
# DATABASE_URL=postgres://aqua:aqua@localhost:5432/aqua_reserve

# Amazon RDS PostgreSQL with IAM authentication. Do not set DATABASE_URL when enabling this mode.
# AQUA_RDS_IAM_AUTH=true
# RDSHOST=database-1.cluster-cz6kc44mkffy.ap-south-1.rds.amazonaws.com
# RDS_PORT=5432
# RDS_DATABASE=postgres
# RDS_USERNAME=postgres
# AWS_REGION=ap-south-1
# RDS_CA_CERT_PATH=C:\path\to\rds-ca-bundle.pem

# Generate persistent 32-byte secrets as base64 values before production or Midnight Preprod use.
# AQUA_MASTER_KEY_BASE64=
# AQUA_CUSTOMER_REFERENCE_KEY_BASE64=
# Use the single-line _BASE64 form for .env files, or raw PEM values in a secret manager.
# AQUA_ISSUER_ED25519_PRIVATE_KEY_PEM_BASE64=
# AQUA_ISSUER_ED25519_PUBLIC_KEY_PEM_BASE64=
# AQUA_ATTESTER_ED25519_PRIVATE_KEY_PEM_BASE64=
# AQUA_ATTESTER_ED25519_PUBLIC_KEY_PEM_BASE64=

# In development only, these demo tokens authenticate the documented test roles.
AQUA_DEMO_AUTH=true
AQUA_ISSUER_TOKEN=issuer-demo-token
AQUA_ATTESTER_TOKEN=attester-demo-token
AQUA_CUSTOMER_TOKEN_PREFIX=customer-demo-token-

# The local adapter is intentionally marked DEVELOPMENT and never claims Midnight anchoring.
MIDNIGHT_ANCHOR_MODE=development
# For Preprod, the API invokes the direct worker in ./midnight. Do not use a generic
# anchor relay or a static contract address: Phase 1 deploys one contract per snapshot.
# MIDNIGHT_ANCHOR_MODE=midnight-preprod
# AQUA_MIDNIGHT_WORKER_DIR=C:\absolute\path\to\backend\midnight
