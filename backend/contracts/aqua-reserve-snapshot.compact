// Aqua Reserve Phase 1 — one immutable, privacy-preserving reserve snapshot.
//
// This contract intentionally stores only commitments, identity commitments,
// status and lifecycle data. It MUST NOT receive balances, customer identities,
// receipt witnesses or reserve-wallet details.
//
// A separate contract instance is deployed for each snapshot. This makes the
// publication immutable by construction; a correction means a new deployment.
pragma language_version 0.23;
import CompactStandardLibrary;

// Lifecycle values. The public web app maps these values to human-readable text.
// 0 = PENDING_ATTESTATION, 1 = VERIFIED, 2 = SHORTFALL, 3 = REVOKED
export ledger status: Uint<8>;

// Public-safe commitments and metadata hashes only.
export ledger snapshotId: Bytes<32>;
export ledger issuerAuthorizationCommitment: Bytes<32>;
export ledger attesterAuthorizationCommitment: Bytes<32>;
export ledger scopeManifestHash: Bytes<32>;
export ledger liabilityRoot: Bytes<32>;
export ledger membershipRoot: Bytes<32>;
export ledger reserveEvidenceCommitment: Bytes<32>;
export ledger coverageEvidenceCommitment: Bytes<32>;
export ledger liabilityEvidenceCommitment: Bytes<32>;
export ledger reserveTotalCommitment: Bytes<32>;
export ledger expiresAt: Uint<64>;
export ledger attestedAt: Uint<64>;
export ledger revocationReasonHash: Bytes<32>;

// The authorisation secrets remain in the issuer/attester prover environment.
// Their preimages are never placed in public contract state.
witness issuerAuthorizationSecret(): Bytes<32>;
witness attesterAuthorizationSecret(): Bytes<32>;
witness liabilityTotal(): Uint<64>;
witness liabilityEvidenceOpening(): Bytes<32>;
witness reserveTotal(): Uint<64>;
witness reserveTotalOpening(): Bytes<32>;

constructor(
  initialSnapshotId: Bytes<32>,
  initialIssuerAuthorizationCommitment: Bytes<32>,
  initialAttesterAuthorizationCommitment: Bytes<32>,
  initialScopeManifestHash: Bytes<32>,
  initialLiabilityRoot: Bytes<32>,
  initialMembershipRoot: Bytes<32>,
  initialReserveEvidenceCommitment: Bytes<32>,
  initialCoverageEvidenceCommitment: Bytes<32>,
  initialLiabilityTotal: Uint<64>,
  initialLiabilityEvidenceOpening: Bytes<32>,
  initialReserveTotal: Uint<64>,
  initialReserveTotalOpening: Bytes<32>,
  initialExpiresAt: Uint<64>
) {
  snapshotId = disclose(initialSnapshotId);
  issuerAuthorizationCommitment = disclose(initialIssuerAuthorizationCommitment);
  attesterAuthorizationCommitment = disclose(initialAttesterAuthorizationCommitment);
  scopeManifestHash = disclose(initialScopeManifestHash);
  liabilityRoot = disclose(initialLiabilityRoot);
  membershipRoot = disclose(initialMembershipRoot);
  reserveEvidenceCommitment = disclose(initialReserveEvidenceCommitment);
  coverageEvidenceCommitment = disclose(initialCoverageEvidenceCommitment);
  liabilityEvidenceCommitment = persistentCommit<Vector<2, Bytes<32>>>(
    [initialMembershipRoot, initialLiabilityTotal as Bytes<32>],
    initialLiabilityEvidenceOpening
  );
  reserveTotalCommitment = persistentCommit<Vector<2, Bytes<32>>>(
    [initialReserveEvidenceCommitment, initialReserveTotal as Bytes<32>],
    initialReserveTotalOpening
  );
  expiresAt = disclose(initialExpiresAt);
  attestedAt = disclose(0);
  revocationReasonHash = disclose(pad(32, "aqua:no-revocation:v1"));
  status = disclose(0);
}

// The issuer authorisation is a ZK proof of knowledge of its private preimage.
// The commitment supplied at deployment is generated off-chain with the same
// domain separator and is included in the signed Aqua evidence payload.
export circuit assertIssuerAuthorised(): [] {
  assert(
    persistentHash<Vector<2, Bytes<32>>>([
      pad(32, "aqua:issuer-authorisation:v1"),
      issuerAuthorizationSecret(),
    ]) == issuerAuthorizationCommitment,
    "Issuer authorisation failed"
  );
}

export circuit attest(attestationTime: Uint<64>): [] {
  assert(status == 0, "Snapshot is no longer pending");
  assert(blockTimeLt(disclose(expiresAt)), "Snapshot has expired");
  assert(
    persistentHash<Vector<2, Bytes<32>>>([
      pad(32, "aqua:attester-authorisation:v1"),
      attesterAuthorizationSecret(),
    ]) == attesterAuthorizationCommitment,
    "Attester authorisation failed"
  );
  const committedLiabilities = persistentCommit<Vector<2, Bytes<32>>>(
    [membershipRoot, liabilityTotal() as Bytes<32>],
    liabilityEvidenceOpening()
  );
  const committedReserves = persistentCommit<Vector<2, Bytes<32>>>(
    [reserveEvidenceCommitment, reserveTotal() as Bytes<32>],
    reserveTotalOpening()
  );
  assert(committedLiabilities == liabilityEvidenceCommitment, "Liability evidence does not match its commitment");
  assert(committedReserves == reserveTotalCommitment, "Reserve evidence does not match its commitment");
  status = disclose(reserveTotal() >= liabilityTotal() ? 1 : 2);
  attestedAt = disclose(attestationTime);
}

export circuit revoke(reasonHash: Bytes<32>): [] {
  assert(status != 3, "Snapshot is already revoked");
  assert(
    persistentHash<Vector<2, Bytes<32>>>([
      pad(32, "aqua:issuer-authorisation:v1"),
      issuerAuthorizationSecret(),
    ]) == issuerAuthorizationCommitment,
    "Issuer authorisation failed"
  );
  revocationReasonHash = disclose(reasonHash);
  status = disclose(3);
}

export circuit isCurrent(): Boolean {
  return status != 3 && blockTimeLt(disclose(expiresAt));
}
